<?xml version="1.1" encoding="UTF-8" standalone="yes"?>
<device xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="CMSIS-SVD.xsd" schemaVersion="1.1">
    <name>LPC2103</name>
    <series>LPC2000</series>
    <version>r4p0</version>
    <description>LPC2103 is a ARM7TDMI based microcontroller.</description>
    
    <!-- CPU -->
    <cpu>
        <name>other</name>
        <revision>r0p0</revision>
        <endian>selectable</endian>
        <fpuPresent>false</fpuPresent>
        <icachePresent>false</icachePresent>
        <dcachePresent>false</dcachePresent>
        <itcmPresent>false</itcmPresent>
        <dtcmPresent>false</dtcmPresent>
        <vtorPresent>false</vtorPresent>
        <nvicPrioBits>2</nvicPrioBits>
        <vendorSystickConfig>true</vendorSystickConfig>
    </cpu>
    
    <!-- System Bus -->
    <addressUnitBits>8</addressUnitBits>
    <width>32</width>
    <access>read-write</access>
    <resetValue>0x00000000</resetValue>
    <resetMask>0xFFFFFFFF</resetMask>

    <peripherals>
        <peripheral>
            <name>SYS</name>
            <description>Memory Acceleration Module</description>
            <baseAddress>0xE01FC000</baseAddress>
            <addressBlock>
                <offset>0x0</offset>
                <size>0x8</size>
                <usage>registers</usage>
            </addressBlock>
            <addressBlock>
                <offset>0x40</offset>
                <size>0x4</size>
                <usage>registers</usage>
            </addressBlock>
            <addressBlock>
                <offset>0x80</offset>
                <size>0x10</size>
                <usage>registers</usage>
            </addressBlock>
            <addressBlock>
                <offset>0xC0</offset>
                <size>0x8</size>
                <usage>registers</usage>
            </addressBlock>
            <addressBlock>
                <offset>0x100</offset>
                <size>0x4</size>
                <usage>registers</usage>
            </addressBlock>
            <addressBlock>
                <offset>0x140</offset>
                <size>0x10</size>
                <usage>registers</usage>
            </addressBlock>
            <addressBlock>
                <offset>0x180</offset>
                <size>0x8</size>
                <usage>registers</usage>
            </addressBlock>
            <addressBlock>
                <offset>0x1A0</offset>
                <size>0x4</size>
                <usage>registers</usage>
            </addressBlock>
            <interrupt>
                <name>PLL</name>
                <description>PLL State Change</description>
                <value>12</value>
            </interrupt>
            <interrupt>
                <name>EINT0</name>
                <description>External Interrupt 0</description>
                <value>14</value>
            </interrupt>
            <interrupt>
                <name>EINT1</name>
                <description>External Interrupt 1</description>
                <value>15</value>
            </interrupt>
            <interrupt>
                <name>EINT2</name>
                <description>External Interrupt 2</description>
                <value>16</value>
            </interrupt>
            <registers>
                <cluster>
                    <name>MAM</name>
                    <description>Memory Accemeration Module</description>
                    <addressOffset>0x0</addressOffset>
                    <register>
                        <name>CR</name>
                        <description>Control Register</description>
                        <addressOffset>0x0</addressOffset>
                        <fields>
                            <field>
                                <name>MODE_CONTROL</name>
                                <bitRange>[1:0]</bitRange>
                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>DISABLED</name>
                                        <value>0b00</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>PARTIAL</name>
                                        <value>0b01</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ENABLED</name>
                                        <value>0b10</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        </fields>
                    </register>
                    <register>
                        <name>TIM</name>
                        <description>Timing Register</description>
                        <addressOffset>0x4</addressOffset>
                        <resetValue>0x00000007</resetValue>
                        <fields>
                            <field>
                                <name>FETCH_CYCLE</name>
                                <bitRange>[2:0]</bitRange>
                                <writeConstraint>
                                    <range>
                                        <minimum>1</minimum>
                                        <maximum>7</maximum>
                                    </range>
                                </writeConstraint>
                            </field>
                        </fields>
                    </register>
                </cluster>
                <register>
                    <name>MEMMAP</name>
                    <description>Memory Map Register</description>
                    <addressOffset>0x40</addressOffset>
                    <fields>
                        <field>
                            <name>MAP</name>
                            <bitRange>[1:0]</bitRange>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>BOOTLOADER</name>
                                    <description>Bootloader memory mapped to interrupt vector.</description>
                                    <value>0b00</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>FLASH</name>
                                    <description>Flash memory mapped to interrupt vector.</description>
                                    <value>0b01</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>SRAM</name>
                                    <description>SRAM mapped to interrupt vector.</description>
                                    <value>0b10</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <cluster>
                    <name>PLL</name>
                    <description>Phased Lock Loop</description>
                    <addressOffset>0x80</addressOffset>
                    <register>
                        <name>CON</name>
                        <description>Control Register</description>
                        <addressOffset>0x0</addressOffset>
                        <fields>
                            <field>
                                <name>PLLE</name>
                                <description>PLL Enable</description>
                                <bitRange>[0:0]</bitRange>
                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>DISABLED</name>
                                        <value>0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ENABLED</name>
                                        <value>1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                            <field>
                                <name>PLLC</name>
                                <description>PLL Connect</description>
                                <bitRange>[1:1]</bitRange>
                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>XTAL</name>
                                        <description>Core clocked through XTAL</description>
                                        <value>0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>PLL</name>
                                        <description>Core clocked through PLL</description>
                                        <value>1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        </fields>
                    </register>
                    <register>
                        <name>CFG</name>
                        <description>Configuration Register</description>
                        <addressOffset>0x4</addressOffset>
                        <fields>
                            <field>
                                <name>MSEL</name>
                                <description>PLL Multiplier</description>
                                <bitRange>[4:0]</bitRange>
                            </field>
                            <field>
                                <name>PSEL</name>
                                <description>PLL Divider Selection</description>
                                <bitRange>[6:5]</bitRange>
                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>DIV1</name>
                                        <value>0b00</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>DIV2</name>
                                        <value>0b01</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>DIV4</name>
                                        <value>0b10</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>DIV8</name>
                                        <value>0b11</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        </fields>
                    </register>
                    <register>
                        <name>STAT</name>
                        <description>Status Register</description>
                        <addressOffset>0x8</addressOffset>
                        <access>read-only</access>
                        <fields>
                            <field>
                                <name>MSEL</name>
                                <description>PLL Multiplier</description>
                                <bitRange>[4:0]</bitRange>
                            </field>
                            <field>
                                <name>PSEL</name>
                                <description>PLL Divider Selection</description>
                                <bitRange>[6:5]</bitRange>
                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>DIV1</name>
                                        <value>0b00</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>DIV2</name>
                                        <value>0b01</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>DIV4</name>
                                        <value>0b10</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>DIV8</name>
                                        <value>0b11</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                            <field>
                                <name>PLLE</name>
                                <description>PLL Enable</description>
                                <bitRange>[8:8]</bitRange>
                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>DISABLED</name>
                                        <value>0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ENABLED</name>
                                        <value>1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                            <field>
                                <name>PLLC</name>
                                <description>PLL Connect</description>
                                <bitRange>[9:9]</bitRange>
                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>XTAL</name>
                                        <description>Core clocked through XTAL</description>
                                        <value>0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>PLL</name>
                                        <description>Core clocked through PLL</description>
                                        <value>1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                            <field>
                                <name>PLOCK</name>
                                <description>PLL Locked</description>
                                <bitRange>[10:10]</bitRange>
                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>UNLOCKED</name>
                                        <description>PLL have not locked.</description>
                                        <value>0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>LOCKED</name>
                                        <description>PLL have locked.</description>
                                        <value>1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        </fields>
                    </register>
                    <register>
                        <name>FEED</name>
                        <description>Feed Register</description>
                        <addressOffset>0xC</addressOffset>
                        <access>write-only</access>
                        <fields>
                            <field>
                                <name>FEED</name>
                                <bitRange>[7:0]</bitRange>
                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>KEY1</name>
                                        <value>0xAA</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>KEY2</name>
                                        <value>0x55</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        </fields>
                    </register>
                </cluster>
                <cluster>
                    <name>PWR</name>
                    <description>Power Control</description>
                    <addressOffset>0xC0</addressOffset>
                    <register>
                        <name>CON</name>
                        <description>Processor Power Control</description>
                        <addressOffset>0x0</addressOffset>
                        <fields>
                            <field>
                                <name>IDL</name>
                                <description>Stop processor until an interrupt comes in.</description>
                                <bitRange>[0:0]</bitRange>
                            </field>
                            <field>
                                <name>PD</name>
                                <description>Power down the microcontroller.</description>
                                <bitRange>[1:1]</bitRange>
                            </field>
                        </fields>
                    </register>
                    <register>
                        <name>CONP</name>
                        <description>Peripheral Power Control</description>
                        <addressOffset>0x4</addressOffset>
                        <resetValue>0x00C8179E</resetValue>
                        <fields>
                            <field>
                                <name>TIM0</name>
                                <bitRange>[1:1]</bitRange>
                            </field>
                            <field>
                                <name>TIM1</name>
                                <bitRange>[2:2]</bitRange>
                            </field>
                            <field>
                                <name>UART0</name>
                                <bitRange>[3:3]</bitRange>
                            </field>
                            <field>
                                <name>UART1</name>
                                <bitRange>[4:4]</bitRange>
                            </field>
                            <field>
                                <name>I2C0</name>
                                <bitRange>[7:7]</bitRange>
                            </field>
                            <field>
                                <name>SPI</name>
                                <bitRange>[8:8]</bitRange>
                            </field>
                            <field>
                                <name>RTC</name>
                                <bitRange>[9:9]</bitRange>
                            </field>
                            <field>
                                <name>SSP</name>
                                <bitRange>[10:10]</bitRange>
                            </field>
                            <field>
                                <name>ADC</name>
                                <bitRange>[12:12]</bitRange>
                            </field>
                            <field>
                                <name>I2C1</name>
                                <bitRange>[19:19]</bitRange>
                            </field>
                            <field>
                                <name>TIM2</name>
                                <bitRange>[22:22]</bitRange>
                            </field>
                            <field>
                                <name>TIM3</name>
                                <bitRange>[23:23]</bitRange>
                            </field>
                        </fields>
                    </register>
                </cluster>
                <register>
                    <name>APBDIV</name>
                    <description>APB Divider</description>
                    <addressOffset>0x100</addressOffset>
                    <fields>
                        <field>
                            <name>DIV</name>
                            <bitRange>[1:0]</bitRange>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>DIV4</name>
                                    <value>0b00</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>DIV1</name>
                                    <value>0b01</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>DIV2</name>
                                    <value>0b10</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <cluster>
                    <name>EINT</name>
                    <description>External Interrupts</description>
                    <addressOffset>0x140</addressOffset>
                    <register>
                        <name>INT</name>
                        <description>Interrupt Register</description>
                        <addressOffset>0x0</addressOffset>
                        <modifiedWriteValues>oneToClear</modifiedWriteValues>
                        <fields>
                            <field>
                                <name>EINT0</name>
                                <bitRange>[0:0]</bitRange>
                            </field>
                            <field>
                                <name>EINT1</name>
                                <bitRange>[1:1]</bitRange>
                            </field>
                            <field>
                                <name>EINT2</name>
                                <bitRange>[2:2]</bitRange>
                            </field>
                        </fields>
                    </register>
                    <register>
                        <name>WAKE</name>
                        <description>Wakeup Register</description>
                        <addressOffset>0x4</addressOffset>
                        <fields>
                            <field>
                                <name>EINT0</name>
                                <bitRange>[0:0]</bitRange>
                            </field>
                            <field>
                                <name>EINT1</name>
                                <bitRange>[1:1]</bitRange>
                            </field>
                            <field>
                                <name>EINT2</name>
                                <bitRange>[2:2]</bitRange>
                            </field>
                            <field>
                                <name>RTC</name>
                                <bitRange>[15:15]</bitRange>
                            </field>
                        </fields>
                    </register>
                    <register>
                        <name>MODE</name>
                        <description>Interrupe Mode Register</description>
                        <addressOffset>0x8</addressOffset>
                        <fields>
                            <field>
                                <name>EINT0</name>
                                <bitRange>[0:0]</bitRange>
                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>LEVEL</name>
                                        <description>Interrupt is level-sensitive.</description>
                                        <value>0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>EDGE</name>
                                        <description>Interrupt is edge-sensitive.</description>
                                        <value>1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                            <field derivedFrom="EINT0">
                                <name>EINT1</name>
                                <bitRange>[1:1]</bitRange>
                            </field>
                            <field derivedFrom="EINT0">
                                <name>EINT2</name>
                                <bitRange>[2:2]</bitRange>
                            </field>
                        </fields>
                    </register>
                    <register>
                        <name>POLAR</name>
                        <description>Interrupt Polarity Register</description>
                        <addressOffset>0xC</addressOffset>
                        <fields>
                            <field>
                                <name>EINT0</name>
                                <bitRange>[0:0]</bitRange>
                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>LOW</name>
                                        <description>Interrupt triggers on LOW level.</description>
                                        <value>0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>HIGH</name>
                                        <description>Interrupt triggers on HIGH level.</description>
                                        <value>1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                            <field derivedFrom="EINT0">
                                <name>EINT1</name>
                                <bitRange>[1:1]</bitRange>
                            </field>
                            <field derivedFrom="EINT0">
                                <name>EINT2</name>
                                <bitRange>[2:2]</bitRange>
                            </field>
                        </fields>
                    </register>
                </cluster>
                <register>
                    <name>RSIR</name>
                    <description>Reset Reason Register</description>
                    <addressOffset>0x180</addressOffset>
                    <modifiedWriteValues>oneToClear</modifiedWriteValues>
                    <fields>
                        <field>
                            <name>POR</name>
                            <bitRange>[0:0]</bitRange>
                        </field>
                        <field>
                            <name>EXTR</name>
                            <bitRange>[1:1]</bitRange>
                        </field>
                        <field>
                            <name>WDTR</name>
                            <bitRange>[2:2]</bitRange>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>CSPR</name>
                    <description>Code Security Protection Register</description>
                    <addressOffset>0x184</addressOffset>
                    <access>read-only</access>
                </register>
                <register>
                    <name>SCS</name>
                    <description>System Control and Status Register</description>
                    <addressOffset>0x1A0</addressOffset>
                    <fields>
                        <field>
                            <name>GPIO0M</name>
                            <description>GPIO0 High-speed Access</description>
                            <bitRange>[0:0]</bitRange>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>DISABLED</name>
                                    <value>0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>ENABLED</name>
                                    <value>1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
            </registers>
        </peripheral>

        <peripheral>
            <name>VIC</name>
            <description>Vectored Interrupt Controller</description>
            <baseAddress>0xFFFFF000</baseAddress>
            <addressBlock>
                <offset>0x000</offset>
                <size>0x24</size>
                <usage>registers</usage>
            </addressBlock>
            <addressBlock>
                <offset>0x030</offset>
                <size>0x8</size>
                <usage>registers</usage>
            </addressBlock>
            <addressBlock>
                <offset>0x100</offset>
                <size>0x40</size>
                <usage>registers</usage>
            </addressBlock>
            <addressBlock>
                <offset>0x200</offset>
                <size>0x40</size>
                <usage>registers</usage>
            </addressBlock>
            <interrupt>
                <name>SOFT_IRQ</name>
                <description>Soft Interrupt</description>
                <value>1</value>
            </interrupt>
            <interrupt>
                <name>CPURX</name>
                <description>CPU Debug RX</description>
                <value>2</value>
            </interrupt>
            <interrupt>
                <name>CPUTX</name>
                <description>CPU Debug TX</description>
                <value>3</value>
            </interrupt>
            <registers>
                <register>
                    <name>IRQStatus</name>
                    <description>IRQ Status Register</description>
                    <addressOffset>0x0</addressOffset>
                    <access>read-only</access>
                    <fields>
                        <field>
                            <dim>32</dim>
                            <dimIncrement>1</dimIncrement>
                            <name>IRQN%s</name>
                            <description>IRQ %s</description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                    </fields>
                </register>
                <register derivedFrom="IRQStatus">
                    <name>FIQStatus</name>
                    <description>FIQ Status Register</description>
                    <addressOffset>0x4</addressOffset>
                    <access>read-only</access>
                </register>
                <register derivedFrom="IRQStatus">
                    <name>RawStatus</name>
                    <description>Raw Status Register</description>
                    <addressOffset>0x8</addressOffset>
                    <access>read-only</access>
                </register>
                <register derivedFrom="IRQStatus">
                    <name>IntSelect</name>
                    <description>Interrupt Path Select Register</description>
                    <addressOffset>0xC</addressOffset>
                    <access>read-write</access>
                </register>
                <register derivedFrom="IRQStatus">
                    <name>IntEnable</name>
                    <description>Interrupt Enable Register</description>
                    <addressOffset>0x10</addressOffset>
                    <access>read-write</access>
                </register>
                <register derivedFrom="IRQStatus">
                    <name>IntDisable</name>
                    <description>Interrupt Disable Register</description>
                    <addressOffset>0x14</addressOffset>
                    <access>write-only</access>
                </register>
                <register derivedFrom="IRQStatus">
                    <name>SoftInt</name>
                    <description>Soft Interrupt Register</description>
                    <addressOffset>0x18</addressOffset>
                    <access>read-write</access>
                </register>
                <register derivedFrom="IRQStatus">
                    <name>SoftIntClear</name>
                    <description>Soft Interrupt Clear Register</description>
                    <addressOffset>0x1C</addressOffset>
                    <access>write-only</access>
                </register>
                <register>
                    <name>Protection</name>
                    <description>Protection Level Register</description>
                    <addressOffset>0x20</addressOffset>
                    <fields>
                        <field>
                            <name>ACCESS</name>
                            <bitRange>[0:0]</bitRange>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>USER</name>
                                    <description>User and privileged modes can access VIC.</description>
                                    <value>0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>PRIVILEGED</name>
                                    <description>Only privileged mode can access VIC.</description>
                                    <value>1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>CurVectAddr</name>
                    <description>Current Vector Address Register</description>
                    <addressOffset>0x30</addressOffset>
                    <access>read-write</access>
                    <modifiedWriteValues>zeroToClear</modifiedWriteValues>
                </register>
                <register>
                    <name>DefVectAddr</name>
                    <description>Default Vector Address Register</description>
                    <addressOffset>0x34</addressOffset>
                    <access>read-write</access>
                </register>
                <register>
                    <dim>16</dim>
                    <dimIncrement>4</dimIncrement>
                    <name>VectAddr[%s]</name>
                    <description>Vector Address Register</description>
                    <addressOffset>0x100</addressOffset>
                </register>
                <register>
                    <dim>16</dim>
                    <dimIncrement>4</dimIncrement>
                    <name>VectCntl[%s]</name>
                    <description>Vector Control Register</description>
                    <addressOffset>0x200</addressOffset>
                    <fields>
                        <field>
                            <name>IRQN</name>
                            <bitRange>[4:0]</bitRange>
                        </field>
                        <field>
                            <name>EN</name>
                            <bitRange>[5:5]</bitRange>
                        </field>
                    </fields>
