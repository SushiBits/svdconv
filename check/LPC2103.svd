                </register>
                <cluster>
                    <name>NOW</name>
                    <description>Datetime</description>
                    <headerStructName>DATETIME</headerStructName>
                    <addressOffset>0x20</addressOffset>
                    <register>
                        <name>SEC</name>
                        <addressOffset>0x0</addressOffset>
                        <writeConstraint>
                            <range>
                                <minimum>0</minimum>
                                <maximum>59</maximum>
                            </range>
                        </writeConstraint>
                    </register>
                    <register>
                        <name>MINUTE</name>
                        <addressOffset>0x04</addressOffset>
                        <writeConstraint>
                            <range>
