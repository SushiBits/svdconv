                                <maximum>59</maximum>
                            </range>
                        </writeConstraint>
                    </register>
                    <register>
                        <name>HOUR</name>
                        <addressOffset>0x08</addressOffset>
                        <writeConstraint>
                            <range>
                                <minimum>0</minimum>
                                <maximum>23</maximum>
                            </range>
                        </writeConstraint>
                    </register>
                    <register>
                        <name>DOM</name>
                        <description>Day of Month</description>
                        <addressOffset>0x0C</addressOffset>
                        <writeConstraint>
                            <range>
                                <minimum>1</minimum>
                                <maximum>31</maximum>
                            </range>
                        </writeConstraint>
                    </register>
                    <register>
                        <name>DOW</name>
                        <description>Day of Week</description>
                        <addressOffset>0x10</addressOffset>
                        <writeConstraint>
