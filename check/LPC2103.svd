                                <maximum>12</maximum>
                            </range>
                        </writeConstraint>
                    </register>
                    <register>
                        <name>YEAR</name>
                        <addressOffset>0x1C</addressOffset>
                        <writeConstraint>
                            <range>
                                <minimum>0</minimum>
                                <maximum>4095</maximum>
                            </range>
                        </writeConstraint>
                    </register>
