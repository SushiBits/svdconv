                            <bitRange>[6:6]</bitRange>
                        </field>
                        <field>
                            <name>YEAR</name>
                            <bitRange>[7:7]</bitRange>
                        </field>
                    </fields>
                </register>
                <register derivedFrom="IIR">
                    <name>AMR</name>
                    <description>Alarm Mask Register</description>
                    <addressOffset>0x10</addressOffset>
