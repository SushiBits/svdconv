                    <register>
                        <name>TARGET_PECCTL</name>
                        <description>I2C Target PEC control register</description>
                        <addressOffset>0x24</addressOffset>
                        <size>32</size>
                        <access>read-write</access>
                        <fields>
                            <field>
                                <name>PECCNT</name>
                                <description>PECCNT Offset</description>
