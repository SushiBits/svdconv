                        <access>read-write</access>
                        <fields>
                            <field>
                                <name>OAR</name>
                                <description>OAR Offset</description>
                                <bitOffset>0x0</bitOffset>
                                <bitWidth>0xA</bitWidth>
                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>MINIMUM</name>
                                        <description>Smallest value</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>MAXIMUM</name>
                                        <description>Highest possible value</description>
                                        <value>0x3FF</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                            <field>
                                <name>OAREN</name>
