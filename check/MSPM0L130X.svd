                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>MODE10</name>
                                        <description>Enable 10-bit addressing</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
