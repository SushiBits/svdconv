                                <bitOffset>0x0</bitOffset>
                                <bitWidth>0x3</bitWidth>
                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>LEVEL_4</name>
                                        <description>Trigger when TX FIFO contains 4 byte</description>
                                        <value>0x4</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>LEVEL_5</name>
                                        <description>Trigger when TX FIFO contains 5 byte</description>
                                        <value>0x5</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>LEVEL_6</name>
                                        <description>Trigger when TX FIFO contains 6 byte</description>
                                        <value>0x6</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>LEVEL_7</name>
                                        <description>Trigger when TX FIFO contains 7 byte</description>
                                        <value>0x7</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                            <field>
                                <name>TXFLUSH</name>
