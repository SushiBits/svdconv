                        <access>read-write</access>
                        <fields>
                            <field>
                                <name>ISEL</name>
                                <description>ISEL Offset</description>
                                <bitOffset>0x0</bitOffset>
                                <bitWidth>0x4</bitWidth>
                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>CCPX_INPUT</name>
                                        <description>CCP of the corresponding capture compare unit</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>CCPX_INPUT_PAIR</name>
                                        <description>Input pair CCPX of the capture compare unit. For CCP0 input pair is CCP1 and for CCP1 input pair is CCP0.</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>CCP0_INPUT</name>
                                        <description>CCP0 of the counter</description>
                                        <value>0x2</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>TRIG_INPUT</name>
                                        <description>Trigger</description>
                                        <value>0x3</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>CCP_XOR</name>
                                        <description>XOR of CCP inputs as input source (Used in Hall input mode).</description>
                                        <value>0x4</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>FSUB0</name>
                                        <description>subscriber 0 event as input source.</description>
                                        <value>0x5</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>FSUB1</name>
                                        <description>subscriber 1 event as input source.</description>
                                        <value>0x6</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>COMP0</name>
                                        <description>Comparator 0 output.</description>
                                        <value>0x7</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>COMP1</name>
                                        <description>Comparator 1 output.</description>
                                        <value>0x8</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>COMP2</name>
                                        <description>Comparator 2 output.</description>
                                        <value>0x9</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                            <field>
                                <name>INV</name>
                                <description>INV Offset</description>
                                <bitOffset>0x7</bitOffset>
                                <bitWidth>0x1</bitWidth>
                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>NOINVERT</name>
                                        <description>Noninverted</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>INVERT</name>
                                        <description>Inverted</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                            <field>
                                <name>FP</name>
                                <description>FP Offset</description>
                                <bitOffset>0x8</bitOffset>
                                <bitWidth>0x2</bitWidth>
                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>_3</name>
                                        <description>The division factor is 3</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>_5</name>
                                        <description>The division factor is 5</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>_8</name>
                                        <description>The division factor is 8</description>
                                        <value>0x2</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                            <field>
                                <name>CPV</name>
                                <description>CPV Offset</description>
                                <bitOffset>0xB</bitOffset>
                                <bitWidth>0x1</bitWidth>
                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>CONSECUTIVE</name>
                                        <description>Consecutive Periods The input must be at a specific logic level for the period defined by FP before it is passed to the filter output.</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>VOTING</name>
                                        <description>Voting The filter ignores one clock of opposite logic over the filter period. I.e. Over FP samples of the input, up to 1 sample may be of an opposite logic value (glitch) without affecting the output.</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                            <field>
                                <name>FE</name>
                                <description>FE Offset</description>
                                <bitOffset>0xC</bitOffset>
                                <bitWidth>0x1</bitWidth>
                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>DISABLED</name>
                                        <description>Bypass.</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ENABLED</name>
                                        <description>Filtered.</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        </fields>
                    </register>
