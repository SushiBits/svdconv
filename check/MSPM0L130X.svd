                                <enumeratedValue>
                                    <name>CH_1</name>
                                    <description>Channel 1 selected</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>CH_2</name>
                                    <description>Channel 2 selected</description>
                                    <value>0x2</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>CH_3</name>
                                    <description>Channel 3 selected</description>
                                    <value>0x3</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>CH_4</name>
                                    <description>Channel 4 selected</description>
                                    <value>0x4</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>CH_5</name>
                                    <description>Channel 5 selected</description>
                                    <value>0x5</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>CH_6</name>
                                    <description>Channel 6 selected</description>
                                    <value>0x6</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>CH_7</name>
                                    <description>Channel 7 selected</description>
                                    <value>0x7</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>IPEN</name>
                            <description>IPEN Offset</description>
                            <bitOffset>0xF</bitOffset>
                            <bitWidth>0x1</bitWidth>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>DISABLE</name>
                                    <description>Selected analog input channel for positive terminal is disabled</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>ENABLE</name>
                                    <description>Selected analog input channel for positive terminal is enabled</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>IMSEL</name>
                            <description>IMSEL Offset</description>
                            <bitOffset>0x10</bitOffset>
                            <bitWidth>0x3</bitWidth>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>CH_0</name>
                                    <description>Channel 0 selected</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>CH_1</name>
                                    <description>Channel 1 selected</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>CH_2</name>
                                    <description>Channel 2 selected</description>
                                    <value>0x2</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>CH_3</name>
                                    <description>Channel 3 selected</description>
                                    <value>0x3</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>CH_4</name>
                                    <description>Channel 4 selected</description>
                                    <value>0x4</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>CH_5</name>
                                    <description>Channel 5 selected</description>
                                    <value>0x5</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>CH_6</name>
                                    <description>Channel 6 selected</description>
                                    <value>0x6</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>CH_7</name>
                                    <description>Channel 7 selected</description>
                                    <value>0x7</value>
                                </enumeratedValue>
                            </enumeratedValues>
