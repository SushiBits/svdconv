                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>MINIMUM</name>
                                        <description>Smallest value</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>MAXIMUM</name>
                                        <description>Highest possible value</description>
                                        <value>0x8</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                            <field>
                                <name>TXFLUSH</name>
