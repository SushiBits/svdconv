                    <register>
                        <name>CONTROLLER_I2CPECCTL</name>
                        <description>I2C Controller PEC control register</description>
                        <addressOffset>0x30</addressOffset>
                        <size>32</size>
                        <access>read-write</access>
                        <fields>
                            <field>
                                <name>PECCNT</name>
                                <description>PECCNT Offset</description>
                                <bitOffset>0x0</bitOffset>
                                <bitWidth>0x9</bitWidth>
                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>MINIMUM</name>
                                        <description>Minimum Value</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>MAXIMUM</name>
                                        <description>Maximum Value</description>
                                        <value>0x1FF</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                            <field>
                                <name>PECEN</name>
                                <description>PECEN Offset</description>
                                <bitOffset>0xC</bitOffset>
                                <bitWidth>0x1</bitWidth>
                                <enumeratedValues>
                                    <enumeratedValue>
                                        <name>DISABLE</name>
                                        <description>PEC is disabled in Controller mode</description>
                                        <value>0x0</value>
                                    </enumeratedValue>
                                    <enumeratedValue>
                                        <name>ENABLE</name>
                                        <description>PEC is enabled in Controller mode</description>
                                        <value>0x1</value>
                                    </enumeratedValue>
                                </enumeratedValues>
                            </field>
                        </fields>
                    </register>
                    <register>
